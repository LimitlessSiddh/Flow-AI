{
  "name": "flow",
  "private": true,
  "version": "0.1.0",
  "description": "Flow: a sports betting research board for NBA, NFL and NHL. Research only, never places bets.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @flow/api --filter @flow/web dev",
    "dev:api": "pnpm --filter @flow/api dev",
    "dev:web": "pnpm --filter @flow/web dev",
    "scan": "pnpm --filter @flow/worker run scan",
    "settle": "pnpm --filter @flow/worker run settle",
    "close": "pnpm --filter @flow/worker run close",
    "record": "pnpm --filter @flow/worker run record",
    "picks": "pnpm --filter @flow/worker run picks",
    "health": "pnpm --filter @flow/worker run doctor",
    "db:migrate": "pnpm --filter @flow/db migrate",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
