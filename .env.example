# Copy this file to .env and fill in what you have. Everything here is free.

# The Odds API free plan (500 credits a month): https://the-odds-api.com
# Used for backup sportsbook prices when no Betway price is available.
ODDS_API_KEY=

# Sportsbooks to ask The Odds API for, best first. Betway Ontario is not in The Odds API,
# so these are the labelled backups. Ontario keys end in _ca_on.
ODDS_BOOKMAKERS=betmgm_ca_on,betrivers_ca_on,proline_ca_on,draftkings,fanduel

# Real prop prices are spread over the month: each scan spends its share of what's left
# (credits left minus this reserve, divided by days left x scans per day).
ODDS_MIN_CREDITS=20
ODDS_SCANS_PER_DAY=2
# Day of the month your Odds API credits reset (see your account page).
ODDS_RESET_DAY=1
# Most games per league to fetch real prop prices for in one scan.
ODDS_PROP_EVENTS=99

# Rate every player in tonight's games against a line Flow estimates from their own numbers.
# Type Betway's real line on a play and Flow re-scores it. on or off.
ESTIMATED_LINES=on

# Your sportsbook. Flow treats prices you type in as this book's price.
PREFERRED_BOOK=Betway

# AI research runs through a command-line agent on this computer, using your own subscription.
# claude = Claude Code (Claude Pro), codex = Codex CLI (ChatGPT Plus), off = skip research.
RESEARCH_PROVIDER=claude
# How many of the top plays get AI research per scan (each one uses some of your plan's usage).
RESEARCH_TOP_N=6

# Where the SQLite database lives (relative to the repo root).
DATABASE_PATH=data/flow.db

# Time zone used to decide what "today" means.
FLOW_TIMEZONE=America/Toronto

API_PORT=8787
